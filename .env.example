# Copy this file to .env.local and fill in your own values.
# Only the six VITE_FIREBASE_* keys are required; the rest are optional.

# Firebase web config (required). Firebase console:
# Project settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (optional). A reCAPTCHA v3 site key enables App Check; leave blank to
# run without it (the default).
VITE_RECAPTCHA_SITE_KEY=

# OpenAI (optional, LOCAL DEV ONLY). Powers the self-explanation judge and AI
# problem generation from the dev server. This is a SECRET: it is gitignored and
# stripped from production builds, where AI routes through the Cloud Functions.
# Never commit a real key.
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=

# Feature flags (optional).
# Set to "true" to let the LLM draft practice problems (each is re-verified by the
# math engine, with an instant local fallback). Defaults to off.
VITE_AI_GENERATION=
# Set to "false" to hide the practice / Daily Treasure Dig feature. Defaults to on.
VITE_PRACTICE_ENABLED=
